"""
event_logger.py
Writes JSONL runtime logs for Lucy.
Each line is a self-contained JSON event record.
"""

import json
from datetime import datetime, timezone
from pathlib import Path


VALID_EVENT_TYPES = {
    "runtime_started",
    "spine_loaded",
    "status_checked",
    "boundary_check",
    "risky_request_blocked",
    "approval_request_created",
    "checkpoint_created",
    "health_checked",
    "memory_saved",
    "memory_recalled",
    "memory_forgotten",
    "projects_updated",
    "reminders_updated",
    "tool_used",
    "approval_reviewed",
    "brain_used",
    "ops_backup_created",
    "ops_scan_created",
    "recovery_reference_viewed",
    "secret_configured",
    "secret_removed",
    "learning_saved",
    "style_saved",
    "cognition_reflected",
    "knowledge_ingested",
    "knowledge_searched",
    "overnight_checkpoint_run",
    "daily_context_updated",
    "daily_context_viewed",
    "continuity_backup_created",
    "continuity_backup_skipped",
    "conversation",
    "error",
}


class EventLogger:
    def __init__(self, logs_dir: Path) -> None:
        self.logs_dir = logs_dir
        self.logs_dir.mkdir(parents=True, exist_ok=True)
        self._log_file = self.logs_dir / "lucy_runtime.jsonl"

    def log(
        self,
        event_type: str,
        message: str,
        source: str = "lucy_core",
        risk_level: str = "none",
        blocked: bool = False,
        approval_required: bool = False,
        extra: dict | None = None,
    ) -> None:
        """Append one event record to the JSONL log file."""
        record: dict = {
            "timestamp": datetime.now(timezone.utc).isoformat(),
            "event_type": event_type if event_type in VALID_EVENT_TYPES else "error",
            "source": source,
            "message": message,
            "risk_level": risk_level,
            "blocked": blocked,
            "approval_required": approval_required,
        }
        if extra:
            record["extra"] = extra

        try:
            with open(self._log_file, "a", encoding="utf-8") as f:
                f.write(json.dumps(record) + "\n")
        except Exception:
            # Never crash Lucy due to logging failure
            pass

    def get_log_path(self) -> Path:
        return self._log_file

    def tail(self, n: int = 10) -> list[dict]:
        """Return the last n log entries."""
        if not self._log_file.exists():
            return []
        lines = self._log_file.read_text(encoding="utf-8").strip().splitlines()
        recent = lines[-n:] if len(lines) >= n else lines
        result = []
        for line in recent:
            try:
                result.append(json.loads(line))
            except Exception:
                pass
        return result
