DEFAULT_CONFIG = {
    "system_name": "LUCY",
    "full_form": "Living Unified Cognitive Yield",
    "stage": "Recovered Lucy V0.1 Checkpoint 023 Architecture / Local Reconstruction / Not Beta Yet",
    "mode": "Safe Local Runtime",
    "web_ui_enabled": True,
