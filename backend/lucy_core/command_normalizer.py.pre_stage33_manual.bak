PREFIX_ALIASES = (
    ("evaluate prposal ", "evaluate proposal "),
    ("eval proposal ", "evaluate proposal "),
    ("eval prposal ", "evaluate proposal "),
    ("shadow test prposal ", "shadow test proposal "),
    ("prepare patch ", "prepare patch plan "),
    ("create patch ", "create patch plan "),
)

CLARIFICATIONS = {
    "proposal": "Do you mean growth proposals status, evaluate proposal, or show growth proposals?",
    "shadow": "Do you mean shadow testing status, run shadow test, or show shadow tests?",
}


def normalize_command(text: str) -> NormalizedCommand:
    original = str(text or "").strip()
    cleaned = re.sub(r"\s+", " ", original)
    lowered = cleaned.lower()

    if lowered in CLARIFICATIONS:
        return NormalizedCommand(text=cleaned, clarification=CLARIFICATIONS[lowered])

    alias = EXACT_ALIASES.get(lowered)
    if alias is not None:
        return NormalizedCommand(text=alias, changed=alias != cleaned)

    for source, target in PREFIX_ALIASES:
        if lowered.startswith(source):
            suffix = cleaned[len(source):].strip()
            if source in {"prepare patch ", "create patch "} and suffix.lower().startswith("plan"):
                return NormalizedCommand(text=cleaned)
            normalized = target + suffix if suffix else target.strip()
            return NormalizedCommand(text=normalized, changed=True)

    return NormalizedCommand(text=cleaned)
