"""
Deterministic command aliases for safe Stage 16 cleanup commands.

This is exact alias handling only. It does not perform fuzzy routing and it
does not normalize unsafe action requests.
"""

from __future__ import annotations

import re
from dataclasses import dataclass


@dataclass(frozen=True)
class NormalizedCommand:
    text: str
    changed: bool = False
    clarification: str = ""


