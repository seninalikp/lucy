    "strategy": "create long-term strategy",
    "strategies": "show long-term strategies",
    "strategy status": "long-term strategy status",
    "long term strategy status": "long-term strategy status",
    "long-term strategy status": "long-term strategy status",
    "create strategy": "create long-term strategy",
    "create long term strategy": "create long-term strategy",
    "create long-term strategy": "create long-term strategy",
    "show strategies": "show long-term strategies",
    "show long term strategies": "show long-term strategies",
    "show long-term strategies": "show long-term strategies",
    "organizer": "create organizer item",
    "organiser": "create organizer item",
    "organizer status": "smart organizer status",
    "organiser status": "smart organizer status",
    "smart organizer status": "smart organizer status",
    "smart organiser status": "smart organizer status",
    "create organizer": "create organizer item",
    "create organiser": "create organizer item",
    "create organizer item": "create organizer item",
    "show organizer": "show organizer items",
    "show organiser": "show organizer items",
    "show organizer items": "show organizer items",
    "organizer items": "show organizer items",
    "organiser items": "show organizer items",
    "safe local actions status": "safe local actions status",
    "safe action status": "safe action status",
    "local action status": "local action status",
    "create safe action proposal": "create safe action proposal",
    "create safe local action proposal": "create safe action proposal",
    "safe action proposal": "safe action proposal",
    "dry run safe action": "dry run safe action",
    "dry-run safe action": "dry run safe action",
    "dry run local action": "dry run safe action",
    "test safe action": "dry run safe action",
    "show safe action proposals": "show safe action proposals",
