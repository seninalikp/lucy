    "valuation lab status": "evaluation lab status",
    "eval lab status": "evaluation lab status",
    "evaluation lab": "evaluation lab status",
    "show evaluation": "show evaluations",
    "evaluate prposal": "evaluate proposal",
    "eval proposal": "evaluate proposal",
    "eval prposal": "evaluate proposal",
    "evaluate groth proposal": "evaluate growth proposals",
    "evaluate growth proposal": "evaluate growth proposals",
    "growth proposal status": "growth proposals status",
    "groth proposal status": "growth proposals status",
    "self modal status": "self model status",
    "shadow test status": "shadow testing status",
    "show shadow test": "show shadow tests",
    "first thot status": "first thought status",
    "run time status": "runtime status",
    "agents status": "agent status",
    "agents report": "agent report",
    "patch status": "patch pipeline status",
    "show patch plan": "show patch plans",
    "prepare patch": "prepare patch plan",
    "create patch": "create patch plan",
    "prepare patch plan": "prepare patch plan",
    "create patch plan": "create patch plan",
