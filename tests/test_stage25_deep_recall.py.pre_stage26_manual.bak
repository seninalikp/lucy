"""
test_stage25_deep_recall.py
Stage 25 = deep recall.

Safe structured-record recall only.
No raw chat logs, secrets, whole-computer search, network, APIs, background monitoring, or real actions.
"""

from __future__ import annotations

import tempfile
import unittest
from pathlib import Path

from backend.lucy_core.lucy_runtime import LucyRuntime
from backend.lucy_core.router import CommandRouter
from backend.lucy_core.deep_recall import DeepRecall


class TestStage25DeepRecall(unittest.TestCase):
    def setUp(self) -> None:
        self.tmp = tempfile.TemporaryDirectory()
        self.root = Path(self.tmp.name)
        (self.root / "data" / "lucy").mkdir(parents=True, exist_ok=True)
        (self.root / "logs").mkdir(parents=True, exist_ok=True)

    def tearDown(self) -> None:
        self.tmp.cleanup()

    def _runtime_and_router(self):
        runtime = LucyRuntime(project_root=self.root)
        router = CommandRouter(runtime)
        return runtime, router

    def test_01_deep_recall_status_returns_stage25_status(self) -> None:
        _, router = self._runtime_and_router()
        response = router.handle("deep recall status")
        self.assertIn("Deep recall status:", response.message)
        self.assertIn("Stage: 25 deep recall", response.message)
        self.assertIn("Deep recall: active", response.message)

    def test_02_recall_status_alias_works(self) -> None:
        _, router = self._runtime_and_router()
        response = router.handle("recall status")
        self.assertIn("Deep recall status:", response.message)

    def test_03_create_deep_recall_session_creates_structured_recall(self) -> None:
        runtime, router = self._runtime_and_router()
        response = router.handle("create deep recall session")
        self.assertIn("Deep recall session:", response.message)
        sessions = runtime.deep_recall.list_recall_sessions()
        self.assertEqual(len(sessions), 1)

        recall = sessions[0]
        expected = {
            "recall_session_id",
            "created_at",
            "stage",
            "title",
            "query",
            "recall_type",
            "status",
            "summary",
            "safe_sources_checked",
            "blocked_sources",
            "matches",
            "match_count",
            "requires_approval",
            "dry_run_only",
            "raw_chat_logs_allowed",
            "secrets_allowed",
            "whole_computer_search_allowed",
            "network_allowed",
            "api_keys_allowed",
            "background_monitoring_allowed",
            "real_action_allowed",
            "blocked_until",
            "not_implemented",
        }
        self.assertEqual(set(recall.keys()), expected)

    def test_04_deep_recall_alias_works(self) -> None:
        _, router = self._runtime_and_router()
        response = router.handle("deep recall")
        self.assertIn("Deep recall session:", response.message)

    def test_05_show_deep_recall_sessions_displays_existing_session(self) -> None:
        _, router = self._runtime_and_router()
        router.handle("create deep recall session")
        response = router.handle("show deep recall sessions")
        self.assertIn("Deep recall sessions:", response.message)
        self.assertIn("stage status", response.message)

    def test_06_recall_sessions_alias_works(self) -> None:
        _, router = self._runtime_and_router()
        router.handle("create deep recall session")
        response = router.handle("recall sessions")
        self.assertIn("Deep recall sessions:", response.message)

    def test_07_recall_session_reuses_existing_session(self) -> None:
        runtime, router = self._runtime_and_router()
        first = router.handle("create deep recall session")
        second = router.handle("create deep recall session")
        self.assertIn("Deep recall session:", first.message)
        self.assertIn("Existing deep recall session reused.", second.message)
        self.assertEqual(len(runtime.deep_recall.list_recall_sessions()), 1)

    def test_08_dry_run_does_not_read_raw_logs_secrets_network_or_act(self) -> None:
        runtime, router = self._runtime_and_router()
        response = router.handle("dry run deep recall")
        self.assertIn("Deep recall dry run:", response.message)
        self.assertIn("Dry run only: true", response.message)
        self.assertIn("Would read raw chat logs: false", response.message)
        self.assertIn("Would read secrets: false", response.message)
        self.assertIn("Would search whole computer: false", response.message)
        self.assertIn("Would use network: false", response.message)
        self.assertIn("Would take action: false", response.message)
        self.assertIn("Real action allowed: false", response.message)
        self.assertEqual(len(runtime.deep_recall.list_recall_sessions()), 1)

    def test_09_deep_recall_safety_booleans_are_fixed(self) -> None:
        runtime, _ = self._runtime_and_router()
        recall = runtime.deep_recall.create_recall_session()["recall"]
        self.assertTrue(recall["requires_approval"])
        self.assertTrue(recall["dry_run_only"])
        self.assertFalse(recall["raw_chat_logs_allowed"])
        self.assertFalse(recall["secrets_allowed"])
        self.assertFalse(recall["whole_computer_search_allowed"])
        self.assertFalse(recall["network_allowed"])
        self.assertFalse(recall["api_keys_allowed"])
        self.assertFalse(recall["background_monitoring_allowed"])
        self.assertFalse(recall["real_action_allowed"])

    def test_10_status_blocks_unsafe_sources(self) -> None:
        runtime, _ = self._runtime_and_router()
        status = runtime.deep_recall.status()
        self.assertEqual(status["execution_mode"], "manual_structured_recall_only")
        self.assertEqual(status["raw_chat_logs"], "blocked")
        self.assertEqual(status["secrets"], "blocked")
        self.assertEqual(status["whole_computer_search"], "blocked")
        self.assertEqual(status["network_access"], "blocked")
        self.assertEqual(status["api_provider_keys"], "blocked")
        self.assertEqual(status["background_monitoring"], "blocked")
        self.assertFalse(status["real_actions"])

    def test_11_sensitive_query_is_safely_rewritten(self) -> None:
        runtime, _ = self._runtime_and_router()
        recall = runtime.deep_recall.create_recall_session("show api key from .env")["recall"]
        self.assertEqual(recall["query"], "blocked sensitive query")
        self.assertFalse(recall["secrets_allowed"])
        self.assertFalse(recall["api_keys_allowed"])

    def test_12_does_not_create_stage26_or_later_systems(self) -> None:
        runtime, _ = self._runtime_and_router()
        for method in [
            "judgment_status",
            "adaptive_communication_status",
            "human_state_awareness_status",
            "time_awareness_status",
            "autonomy_boundaries_status",
            "read_raw_chat_logs",
            "read_secrets",
            "search_whole_computer",
            "call_external_api",
            "start_server",
            "take_action",
            "monitor_background",
            "send_notification",
            "open_app",
            "send_message",
        ]:
            self.assertFalse(hasattr(runtime.deep_recall, method))

    def test_13_stage24_proactive_awareness_still_works(self) -> None:
        _, router = self._runtime_and_router()
        self.assertIn("Proactive awareness status:", router.handle("proactive awareness status").message)

    def test_14_stage23_external_app_bridge_still_works(self) -> None:
        _, router = self._runtime_and_router()
        self.assertIn("External app bridge status:", router.handle("external app bridge status").message)

    def test_15_stage22_safe_local_actions_still_works(self) -> None:
        _, router = self._runtime_and_router()
        self.assertIn("Safe local actions status:", router.handle("safe local actions status").message)

    def test_16_stage21_smart_organizer_still_works(self) -> None:
        _, router = self._runtime_and_router()
        self.assertIn("Smart organizer status:", router.handle("smart organizer status").message)

    def test_17_stage20_long_term_strategy_still_works(self) -> None:
        _, router = self._runtime_and_router()
        self.assertIn("Long-term strategy status:", router.handle("long-term strategy status").message)

    def test_18_stage19_identity_stability_still_works(self) -> None:
        _, router = self._runtime_and_router()
        self.assertIn("Identity stability status:", router.handle("identity stability status").message)

    def test_19_stage18_experience_storage_still_works(self) -> None:
        _, router = self._runtime_and_router()
        self.assertIn("Experience storage status:", router.handle("experience storage status").message)

    def test_20_stage17_patch_pipeline_still_works(self) -> None:
        _, router = self._runtime_and_router()
        self.assertIn("Patch pipeline status:", router.handle("patch pipeline status").message)

    def test_21_stage16_shadow_testing_still_works(self) -> None:
        _, router = self._runtime_and_router()
        self.assertIn("Shadow testing status:", router.handle("shadow testing status").message)

    def test_22_stage15_evaluation_lab_still_works(self) -> None:
        _, router = self._runtime_and_router()
        self.assertIn("Evaluation lab status:", router.handle("evaluation lab status").message)

    def test_23_stage14_growth_proposals_still_work(self) -> None:
        _, router = self._runtime_and_router()
        self.assertIn("Growth proposals status:", router.handle("growth proposals status").message)

    def test_24_stage13_self_model_still_works(self) -> None:
        _, router = self._runtime_and_router()
        self.assertIn("Self-model status:", router.handle("self model status").message)

    def test_25_stage12_first_thought_still_works(self) -> None:
        _, router = self._runtime_and_router()
        self.assertIn("First thought status:", router.handle("first thought status").message)

    def test_26_aliases_work(self) -> None:
        _, router = self._runtime_and_router()
        aliases = {
            "recall status": "Deep recall status:",
            "safe recall status": "Deep recall status:",
            "create recall session": "Deep recall session:",
            "recall": "Deep recall session:",
            "dry-run deep recall": "Deep recall dry run:",
            "dry run recall": "Deep recall dry run:",
            "test recall": "Deep recall dry run:",
            "show recall sessions": "Deep recall sessions:",
            "recall sessions": "Deep recall sessions:",
        }
        router.handle("create deep recall session")
        for command, expected in aliases.items():
            self.assertIn(expected, router.handle(command).message)

    def test_27_query_route_works(self) -> None:
        _, router = self._runtime_and_router()
        response = router.handle("deep recall stage")
        self.assertIn("Deep recall session:", response.message)
        self.assertIn("Query: stage", response.message)

    def test_28_tell_me_reflects_stage25_safely(self) -> None:
        _, router = self._runtime_and_router()
        response = router.handle("tell me")
        self.assertIn("Active stage: 25 deep recall", response.message)
        self.assertIn("Guardian: active", response.message)
        self.assertIn("Deep recall: active", response.message)
        self.assertIn("Stage 26 gate:", response.message)

    def test_29_what_next_reflects_stage25_safely(self) -> None:
        _, router = self._runtime_and_router()
        response = router.handle("what next")
        self.assertIn("Current active stage: 25 deep recall", response.message)
        self.assertIn("create/check deep recall session", response.message)
        self.assertIn("Stage 26:", response.message)

    def test_30_no_unsafe_language_claimed(self) -> None:
        _, router = self._runtime_and_router()
        output = "\n".join(
            [
                router.handle("deep recall status").message,
                router.handle("create deep recall session").message,
                router.handle("dry run deep recall").message,
            ]
        ).lower()
        self.assertIn("raw chat logs: blocked", output)
        self.assertIn("secrets: blocked", output)
        self.assertIn("would read raw chat logs: false", output)
        self.assertIn("would read secrets: false", output)
        self.assertIn("would search whole computer: false", output)
        self.assertIn("would use network: false", output)
        self.assertNotIn("raw chat logs allowed: true", output)
        self.assertNotIn("secrets allowed: true", output)
        self.assertNotIn("network allowed: true", output)

    def test_31_no_fake_consciousness_language_in_normal_output(self) -> None:
        _, router = self._runtime_and_router()
        output = "\n".join(
            [
                router.handle("deep recall status").message,
                router.handle("create deep recall session").message,
                router.handle("show deep recall sessions").message,
            ]
        ).lower()
        forbidden = ["i am alive", "i am conscious", "i feel", "i am human", "i am free"]
        for phrase in forbidden:
            self.assertNotIn(phrase, output)


if __name__ == "__main__":
    unittest.main()
