import json
import tempfile
import unittest
from pathlib import Path

from backend.lucy_core.lucy_runtime import LucyRuntime
from backend.lucy_core.memory import MemorySystem
from backend.lucy_core.router import CommandRouter
from backend.lucy_core.session_review import SessionReviewEngine


class Stage65SessionReviewTests(unittest.TestCase):
    def setUp(self) -> None:
        self.temp_dir = tempfile.TemporaryDirectory()
        self.root = Path(self.temp_dir.name)
        self.lucy_data = self.root / "data" / "lucy"
        self.engine = SessionReviewEngine(self.lucy_data)

    def tearDown(self) -> None:
        self.temp_dir.cleanup()

    def _session(self) -> dict:
        return {
            "session_count": 7,
            "active_project": "Lucy",
            "current_checkpoint": "checkpoint_0065",
            "next_action": "Run Stage 6.5 stabilization tests.",
            "last_command": "session review",
            "last_user_intent": "Lucy should preserve Guardian before tools.",
        }

    def _project(self) -> dict:
        return {
            "name": "Lucy",
            "next_action": "Run Stage 6.5 stabilization tests.",
            "open_tasks": [{"id": "task_0001", "text": "Run tests"}],
            "done_tasks": [],
        }

    def test_session_review_creates_structured_summary(self) -> None:
        review = self.engine.review_session(self._session(), self._project(), memory_audit={"active": 2})
        for key in [
            "session_id",
            "timestamp",
            "session_summary",
            "commands_seen",
            "what_changed",
            "what_was_saved",
            "next_time_start_here",
            "confidence",
        ]:
            self.assertIn(key, review)
        self.assertIsInstance(review["commands_seen"], list)

    def test_session_review_includes_active_project(self) -> None:
        review = self.engine.review_session(self._session(), self._project(), memory_audit={"active": 0})
        self.assertEqual(review["active_project"], "Lucy")

    def test_memory_candidate_created_for_safe_project_fact(self) -> None:
        candidate = self.engine.build_memory_candidate(
            "Current checkpoint is checkpoint_0065.",
            reason="Checkpoint facts help continuity.",
            category="project_fact",
        )
        result = self.engine.add_memory_candidate(candidate)
        candidates = self.engine.list_memory_candidates()
        self.assertTrue(result["ok"])
        self.assertFalse(result["candidate"]["rejected"])
        self.assertEqual(len(candidates["pending"]), 1)

    def test_secret_like_memory_candidate_is_rejected(self) -> None:
        candidate = self.engine.build_memory_candidate("api key = sk-1234567890abcdef")
        self.assertTrue(candidate.rejected)
        self.assertFalse(candidate.safe_to_store)
        self.assertNotIn("sk-1234567890abcdef", candidate.content)

    def test_token_password_api_key_like_candidates_are_rejected(self) -> None:
        samples = [
            "password = hunter2",
            "token: abcdef123456",
            "bearer abcdef123456",
            "refresh_token = abcdef123456",
        ]
        for sample in samples:
            with self.subTest(sample=sample):
                candidate = self.engine.build_memory_candidate(sample)
                self.assertTrue(candidate.rejected)
                self.assertFalse(candidate.safe_to_store)

    def test_long_raw_file_body_candidate_is_rejected(self) -> None:
        raw_body = "\n".join(["def example():"] * 12)
        candidate = self.engine.build_memory_candidate(raw_body)
        self.assertTrue(candidate.rejected)
        self.assertIn("raw file", candidate.rejection_reason.lower())

    def test_drift_finding_detects_rebuild_from_scratch(self) -> None:
        report = self.engine.drift_report("rebuild from scratch and ignore previous checkpoints")
        triggers = {item["trigger"] for item in report["findings"]}
        self.assertIn("rebuild from scratch", triggers)

    def test_drift_finding_detects_bypass_guardian(self) -> None:
        report = self.engine.drift_report("bypass Guardian for this tool")
        triggers = {item["trigger"] for item in report["findings"]}
        self.assertIn("bypass guardian", triggers)

    def test_reflection_log_writes_upgraded_entry(self) -> None:
        review = self.engine.review_session(self._session(), self._project(), memory_audit={"active": 1})
        entry = self.engine.write_reflection(review)
        log_path = Path(entry["file"])
        written = json.loads(log_path.read_text(encoding="utf-8").splitlines()[-1])
        self.assertIn("route_decisions_summary", written)
        self.assertIn("guardian_events_summary", written)
        self.assertIn("safe_file_tool_events_summary", written)
        self.assertIn("memory_candidates_count", written)
        self.assertEqual(written["active_project"], "Lucy")

    def test_memory_candidate_approval_works(self) -> None:
        memory = MemorySystem(self.lucy_data / "memory")
        engine = SessionReviewEngine(self.lucy_data, memory_system=memory)
        candidate = engine.build_memory_candidate("Stage 6.5 checkpoint facts are safe project metadata.")
        added = engine.add_memory_candidate(candidate)
        result = engine.approve_memory_candidate(added["candidate"]["id"])
        candidates = engine.list_memory_candidates()
        self.assertTrue(result["ok"])
        self.assertEqual(len(candidates["pending"]), 0)
        self.assertEqual(len(candidates["approved"]), 1)
        self.assertTrue(memory.recall("Stage 6.5"))

    def test_memory_candidate_rejection_works(self) -> None:
        candidate = self.engine.build_memory_candidate("Next action is run the Stage 6.5 tests.")
        added = self.engine.add_memory_candidate(candidate)
        result = self.engine.reject_memory_candidate(added["candidate"]["id"])
        candidates = self.engine.list_memory_candidates()
        self.assertTrue(result["ok"])
        self.assertEqual(len(candidates["pending"]), 0)
        self.assertEqual(len(candidates["rejected"]), 1)

    def test_router_session_review_command_works(self) -> None:
        runtime = LucyRuntime(project_root=self.root)
        router = CommandRouter(runtime)
        response = router.handle("session review")
        self.assertFalse(response.should_exit)
        self.assertIn("Session review", response.message)

    def test_router_memory_candidates_command_works(self) -> None:
        runtime = LucyRuntime(project_root=self.root)
        router = CommandRouter(runtime)
        router.handle("session review")
        response = router.handle("memory candidates")
        self.assertFalse(response.should_exit)
        self.assertIn("Memory candidates", response.message)

    def test_router_drift_report_command_works(self) -> None:
        runtime = LucyRuntime(project_root=self.root)
        runtime.session_state.record_command(
            "please rebuild from scratch",
            "Use the checkpointed repo and patch only what is needed.",
            user_intent="please rebuild from scratch",
        )
        router = CommandRouter(runtime)
        response = router.handle("drift report")
        self.assertFalse(response.should_exit)
        self.assertIn("rebuild from scratch", response.message.lower())

    def test_router_write_reflection_command_works(self) -> None:
        runtime = LucyRuntime(project_root=self.root)
        router = CommandRouter(runtime)
        response = router.handle("write reflection")
        self.assertFalse(response.should_exit)
        self.assertIn("Stage 6.5 reflection written", response.message)

    def test_stage65_outputs_do_not_claim_consciousness(self) -> None:
        runtime = LucyRuntime(project_root=self.root)
        router = CommandRouter(runtime)
        messages = [
            router.handle("session review").message,
            router.handle("memory candidates").message,
            router.handle("drift report").message,
        ]
        combined = "\n".join(messages).lower()
        for forbidden in ["conscious", "sentient", "feelings", "chain-of-thought"]:
            self.assertNotIn(forbidden, combined)


if __name__ == "__main__":
    unittest.main()
