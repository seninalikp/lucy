"""
test_stage31_provider_identity_boundary.py
Stage 31 = Provider / API Identity Boundary.

No API keys are read.
No provider is called.
No network is used.

This stage locks:
Provider = tool.
Model = tool.
API key = credential.
External answer = tool output.
Lucy identity = local Guardian + memory + runtime + project state.
"""

from __future__ import annotations

import tempfile
import unittest
from pathlib import Path

from backend.lucy_core.lucy_runtime import LucyRuntime
from backend.lucy_core.router import CommandRouter


class TestStage31ProviderIdentityBoundary(unittest.TestCase):
    def setUp(self) -> None:
        self.tmp = tempfile.TemporaryDirectory()
        self.root = Path(self.tmp.name)
        (self.root / "data" / "lucy").mkdir(parents=True, exist_ok=True)
        (self.root / "logs").mkdir(parents=True, exist_ok=True)

    def tearDown(self) -> None:
        self.tmp.cleanup()

    def _runtime_and_router(self):
        runtime = LucyRuntime(project_root=self.root)
        router = CommandRouter(runtime)
        return runtime, router

    def test_01_provider_identity_status_returns_stage31_status(self) -> None:
        _, router = self._runtime_and_router()
        response = router.handle("provider identity boundary status")
        self.assertIn("Provider identity boundary status:", response.message)
        self.assertIn("Stage: 31 provider/api identity boundary", response.message)
        self.assertIn("Provider identity boundary: active", response.message)

    def test_02_status_aliases_work(self) -> None:
        _, router = self._runtime_and_router()
        for command in ["provider identity status", "provider boundary status", "api identity status"]:
            self.assertIn("Provider identity boundary status:", router.handle(command).message)

    def test_03_status_locks_provider_as_tool_not_identity(self) -> None:
        _, router = self._runtime_and_router()
        response = router.handle("provider identity boundary status")
        self.assertIn("Lucy identity source: local_guardian_memory_runtime_project_state", response.message)
        self.assertIn("Provider role: external_tool_only", response.message)
        self.assertIn("Model role: external_tool_only", response.message)
        self.assertIn("API key role: credential_only", response.message)
        self.assertIn("External answer role: tool_output_only", response.message)
        self.assertIn("Provider can replace Lucy identity: false", response.message)
        self.assertIn("Model can replace Lucy identity: false", response.message)

    def test_04_status_blocks_key_reading_and_provider_calls(self) -> None:
        _, router = self._runtime_and_router()
        response = router.handle("provider identity boundary status")
        self.assertIn("API key file reading: blocked_until_stage_32", response.message)
        self.assertIn("API key loading: blocked_until_stage_32", response.message)
        self.assertIn("Provider calls: blocked", response.message)
        self.assertIn("Network access: blocked", response.message)
        self.assertIn("Real actions: false", response.message)

    def test_05_create_boundary_record_creates_structured_record(self) -> None:
        runtime, router = self._runtime_and_router()
        response = router.handle("create provider identity boundary record")
        self.assertIn("Provider identity boundary record:", response.message)

        records = runtime.provider_identity_boundary.list_boundary_records()
        self.assertEqual(len(records), 1)

        expected = {
            "boundary_record_id",
            "created_at",
            "stage",
            "title",
            "context",
            "boundary_type",
            "status",
            "category",
            "decision",
            "summary",
            "allowed_response",
            "recommended_next_step",
            "lucy_identity_source",
            "provider_role",
            "model_role",
            "api_key_role",
            "external_answer_role",
            "requires_user_approval",
            "dry_run_only",
            "identity_boundary_only",
            "provider_can_replace_lucy_identity",
            "model_can_replace_lucy_identity",
            "api_output_can_override_guardian",
            "api_output_can_override_memory",
            "api_output_can_override_runtime_state",
            "api_key_file_reading_allowed",
            "api_key_loading_allowed",
            "provider_call_allowed",
            "network_allowed",
            "model_routing_allowed",
            "provider_health_check_allowed",
            "external_model_execution_allowed",
            "provider_output_ingestion_allowed",
            "cost_quota_tracking_allowed",
            "real_action_allowed",
            "blocked_until",
            "not_implemented",
        }
        self.assertEqual(set(records[0].keys()), expected)

    def test_06_default_boundary_alias_works(self) -> None:
        _, router = self._runtime_and_router()
        response = router.handle("provider identity boundary")
        self.assertIn("Provider identity boundary record:", response.message)

    def test_07_default_record_reuses_existing_record(self) -> None:
        runtime, router = self._runtime_and_router()
        first = router.handle("create provider identity boundary record")
        second = router.handle("create provider identity boundary record")
        self.assertIn("Provider identity boundary record:", first.message)
        self.assertIn("Existing provider identity boundary record reused.", second.message)
        self.assertEqual(len(runtime.provider_identity_boundary.list_boundary_records()), 1)

    def test_08_local_identity_boundary_is_allowed_only_as_boundary(self) -> None:
        _, router = self._runtime_and_router()
        response = router.handle("provider identity boundary provider and model are tools not lucy")
        self.assertIn("Category: local_identity_boundary", response.message)
        self.assertIn("Decision: allowed_as_identity_boundary_only", response.message)
        self.assertIn("Identity boundary only: true", response.message)

    def test_09_named_provider_is_classified_as_tool(self) -> None:
        _, router = self._runtime_and_router()
        response = router.handle("provider boundary groq is an external tool")
        self.assertIn("Category: provider_named_as_tool", response.message)
        self.assertIn("Decision: allowed_as_identity_boundary_only", response.message)
        self.assertIn("Provider role: external_tool_only", response.message)

    def test_10_api_key_handling_is_blocked_before_stage32(self) -> None:
        _, router = self._runtime_and_router()
        response = router.handle("provider identity boundary read api key from file")
        self.assertIn("Category: blocked_key_handling_before_stage32", response.message)
        self.assertIn("Decision: blocked", response.message)
        self.assertIn("API key file reading allowed: false", response.message)
        self.assertIn("API key loading allowed: false", response.message)

    def test_11_provider_execution_is_blocked(self) -> None:
        _, router = self._runtime_and_router()
        response = router.handle("provider identity boundary call provider and network request")
        self.assertIn("Category: blocked_provider_execution_before_later_stage", response.message)
        self.assertIn("Decision: blocked", response.message)
        self.assertIn("Provider call allowed: false", response.message)
        self.assertIn("Network allowed: false", response.message)

    def test_12_provider_identity_confusion_is_corrected(self) -> None:
        _, router = self._runtime_and_router()
        response = router.handle("api identity boundary gemini is lucy")
        self.assertIn("Category: blocked_provider_identity_confusion", response.message)
        self.assertIn("Decision: corrected", response.message)
        self.assertIn("Provider can replace Lucy identity: false", response.message)
        self.assertIn("Model can replace Lucy identity: false", response.message)

    def test_13_all_core_providers_are_tools_not_identity(self) -> None:
        _, router = self._runtime_and_router()
        for provider in ["google", "gemini", "openrouter", "groq", "nvidia"]:
            response = router.handle(f"provider identity boundary {provider} tool boundary")
            self.assertIn("Category: provider_named_as_tool", response.message)
            self.assertIn("Provider role: external_tool_only", response.message)

    def test_14_dry_run_blocks_all_provider_execution(self) -> None:
        _, router = self._runtime_and_router()
        response = router.handle("dry run provider identity boundary")
        self.assertIn("Provider identity boundary dry run:", response.message)
        self.assertIn("Dry run only: true", response.message)
        self.assertIn("Would read API key file: false", response.message)
        self.assertIn("Would load API keys: false", response.message)
        self.assertIn("Would call provider: false", response.message)
        self.assertIn("Would use network: false", response.message)
        self.assertIn("Would route model: false", response.message)
        self.assertIn("Would run provider health check: false", response.message)
        self.assertIn("Would execute external model: false", response.message)
        self.assertIn("Would ingest provider output: false", response.message)
        self.assertIn("Would replace Lucy identity: false", response.message)
        self.assertIn("Would override Guardian: false", response.message)
        self.assertIn("Would override memory: false", response.message)
        self.assertIn("Would override runtime state: false", response.message)
        self.assertIn("Would take real action: false", response.message)

    def test_15_dry_run_aliases_work(self) -> None:
        _, router = self._runtime_and_router()
        for command in [
            "dry-run provider identity boundary",
            "dry run provider boundary",
            "test provider identity boundary",
            "test provider identity",
        ]:
            self.assertIn("Provider identity boundary dry run:", router.handle(command).message)

    def test_16_show_provider_identity_records_displays_existing_record(self) -> None:
        _, router = self._runtime_and_router()
        router.handle("provider identity boundary groq is a tool")
        response = router.handle("show provider identity boundary records")
        self.assertIn("Provider identity boundary records:", response.message)
        self.assertIn("groq is a tool", response.message.lower())

    def test_17_boundary_record_list_aliases_work(self) -> None:
        _, router = self._runtime_and_router()
        router.handle("create provider identity boundary record")
        for command in ["show provider boundary records", "provider identity records", "provider boundary records"]:
            self.assertIn("Provider identity boundary records:", router.handle(command).message)

    def test_18_record_safety_booleans_are_fixed(self) -> None:
        runtime, _ = self._runtime_and_router()
        record = runtime.provider_identity_boundary.create_boundary_record("gemini is a tool")["boundary_record"]
        self.assertTrue(record["requires_user_approval"])
        self.assertTrue(record["dry_run_only"])
        self.assertTrue(record["identity_boundary_only"])
        self.assertFalse(record["provider_can_replace_lucy_identity"])
        self.assertFalse(record["model_can_replace_lucy_identity"])
        self.assertFalse(record["api_output_can_override_guardian"])
        self.assertFalse(record["api_output_can_override_memory"])
        self.assertFalse(record["api_output_can_override_runtime_state"])
        self.assertFalse(record["api_key_file_reading_allowed"])
        self.assertFalse(record["api_key_loading_allowed"])
        self.assertFalse(record["provider_call_allowed"])
        self.assertFalse(record["network_allowed"])
        self.assertFalse(record["model_routing_allowed"])
        self.assertFalse(record["provider_health_check_allowed"])
        self.assertFalse(record["external_model_execution_allowed"])
        self.assertFalse(record["provider_output_ingestion_allowed"])
        self.assertFalse(record["cost_quota_tracking_allowed"])
        self.assertFalse(record["real_action_allowed"])

    def test_19_does_not_create_key_loader_or_provider_client(self) -> None:
        runtime, _ = self._runtime_and_router()
        for method in [
            "read_api_keys",
            "load_api_keys",
            "load_key_file",
            "get_provider_key",
            "call_provider",
            "call_groq",
            "call_gemini",
            "call_openrouter",
            "call_nvidia",
            "provider_router",
            "provider_health_check",
            "network_request",
        ]:
            self.assertFalse(hasattr(runtime.provider_identity_boundary, method))

    def test_20_autonomy_boundaries_still_work(self) -> None:
        _, router = self._runtime_and_router()
        self.assertIn("Autonomy boundaries status:", router.handle("autonomy boundaries status").message)

    def test_21_stage29_time_awareness_still_works(self) -> None:
        _, router = self._runtime_and_router()
        self.assertIn("Time awareness status:", router.handle("time awareness status").message)

    def test_22_stage28_human_state_awareness_still_works(self) -> None:
        _, router = self._runtime_and_router()
        self.assertIn("Human-state awareness status:", router.handle("human state awareness status").message)

    def test_23_stage27_adaptive_communication_still_works(self) -> None:
        _, router = self._runtime_and_router()
        self.assertIn("Adaptive communication status:", router.handle("adaptive communication status").message)

    def test_24_stage26_judgment_still_works(self) -> None:
        _, router = self._runtime_and_router()
        self.assertIn("Judgment status:", router.handle("judgment status").message)

    def test_25_stage25_deep_recall_still_works(self) -> None:
        _, router = self._runtime_and_router()
        self.assertIn("Deep recall status:", router.handle("deep recall status").message)

    def test_26_tell_me_reflects_stage31_safely(self) -> None:
        _, router = self._runtime_and_router()
        response = router.handle("tell me")
        self.assertIn("Active stage: 31 provider/api identity boundary", response.message)
        self.assertIn("Guardian: active", response.message)
        self.assertIn("Provider identity boundary: active", response.message)
        self.assertIn("Provider identity records:", response.message)
        self.assertIn("Stage 32 gate:", response.message)

    def test_27_what_next_reflects_stage31_safely(self) -> None:
        _, router = self._runtime_and_router()
        response = router.handle("what next")
        self.assertIn("Current active stage: 31 provider/api identity boundary", response.message)
        self.assertIn("create/check provider identity boundary record", response.message)
        self.assertIn("Stage 32:", response.message)

    def test_28_no_unsafe_key_or_network_language_claimed(self) -> None:
        _, router = self._runtime_and_router()
        output = "\n".join(
            [
                router.handle("provider identity boundary status").message,
                router.handle("provider identity boundary read api key and call provider").message,
                router.handle("dry run provider identity boundary").message,
            ]
        ).lower()
        self.assertIn("api key file reading: blocked_until_stage_32", output)
        self.assertIn("provider calls: blocked", output)
        self.assertIn("network access: blocked", output)
        self.assertIn("would read api key file: false", output)
        self.assertIn("would call provider: false", output)
        self.assertIn("would use network: false", output)
        self.assertNotIn("api key file reading allowed: true", output)
        self.assertNotIn("provider call allowed: true", output)
        self.assertNotIn("network allowed: true", output)

    def test_29_no_fake_consciousness_language_in_normal_output(self) -> None:
        _, router = self._runtime_and_router()
        output = "\n".join(
            [
                router.handle("provider identity boundary status").message,
                router.handle("create provider identity boundary record").message,
                router.handle("show provider identity boundary records").message,
            ]
        ).lower()
        forbidden = ["i am alive", "i am conscious", "i feel", "i am human", "i am free"]
        for phrase in forbidden:
            self.assertNotIn(phrase, output)

    def test_30_stage32_key_safety_stage_is_blocked(self) -> None:
        _, router = self._runtime_and_router()
        output = router.handle("what next").message
        self.assertIn("Stage 32:", output)
        self.assertIn("Secrets/provider-key safety stage blocked", output)

    def test_31_api_keys_file_is_not_read_by_stage31(self) -> None:
        fake_key_file = self.root / "APIKEYS"
        fake_key_file.write_text("GROQ API KEY=SECRET_SHOULD_NOT_BE_READ", encoding="utf-8")

        _, router = self._runtime_and_router()
        output = router.handle("provider identity boundary status").message
        self.assertIn("API key file reading: blocked_until_stage_32", output)
        self.assertNotIn("SECRET_SHOULD_NOT_BE_READ", output)


if __name__ == "__main__":
    unittest.main()
