# ==============================================================================
# LUCY (Living Unified Cognitive Yield) Environment Configuration Template
# Copy this file to .env and populate with your credentials/settings.
# Never commit .env to version control.
# ==============================================================================

# Server Configuration
LUCY_PORT=7700

# Optional: Preferred Provider Order (comma-separated, e.g. "nvidia,groq,openrouter,gemini,sambanova")
LUCY_API_ORDER=

# Optional: Path overrides for external vault / collections
LUCY_ELIE_ROOT=
LUCY_AI_COLLECTIONS_ROOT=

# LLM Providers (External Chat Tools)
# NVIDIA NIM / NGC
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# SambaNova
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.1-70B-Instruct
